# Secrets -- never commit these
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*_secret*
*_credentials*
secrets.yaml
secrets.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated artifacts -- rebuildable from source, so not source
data/indexes/*
!data/indexes/.gitkeep
data/cache/*
!data/cache/.gitkeep
logs/
*.log

# Runtime databases -- contain user data, never commit
data/users.db
data/memory.db
data/memory.db-shm
data/memory.db-wal
data/deep_dive_cache.json

# Streamlit local secrets (use Streamlit Cloud secrets UI instead)
.streamlit/secrets.toml

# OS / editor noise
.DS_Store
Thumbs.db

# Source PDFs - large, copyrighted, not redistributable
docs/Varsity PDFs/
