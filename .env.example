# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. This file is committed, so it must never contain a real key.

# Required -- https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-me

# Optional -- https://www.alphavantage.co/support/#api-key
# Only used as the Phase 6 fallback when yfinance fails.
ALPHA_VANTAGE_API_KEY=

# Optional overrides. Anything here wins over config.yaml.
# FINNIE_LOG_LEVEL=DEBUG
# FINNIE_LLM__MODEL=gpt-4o-mini
